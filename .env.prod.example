# Dùng cho docker-compose.prod.yml:  cp .env.prod.example .env.prod  rồi đổi mật khẩu.
# .env.prod nằm trong .gitignore — không commit.

# Nơi tải image gốc (MySQL, Maven, JRE). Mạng không vào được ECR Public thì đổi thành docker.io/library
IMAGE_REGISTRY=public.ecr.aws/docker/library

# ==== MySQL (chỉ ứng dụng truy cập được, không mở cổng ra ngoài) ====
MYSQL_DATABASE=comic_utc
MYSQL_USER=comic
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ==== Ứng dụng ====
APP_PORT=8080
# prod: CSDL trống, chỉ có tài khoản admin. prod,demo: nạp thêm tài khoản và truyện demo (máy chấm, buổi bảo vệ).
SPRING_PROFILES_ACTIVE=prod
# Cookie phiên chỉ gửi qua HTTPS. Đặt false khi chạy thử bằng http (vd. http://192.168.1.10:8080 trên mạng LAN).
SESSION_COOKIE_SECURE=true

# ==== Chatbot (Spring AI) — để trống thì chatbot dùng đường lui tìm theo từ khóa ====
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
