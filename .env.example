# Tùy chọn: compose và ứng dụng đã có giá trị mặc định khớp nhau.
# Chỉ cần `cp .env.example .env` khi muốn đổi cổng, mật khẩu DB hoặc bật chatbot.

# ==== MySQL ====
MYSQL_DATABASE=comic_utc
MYSQL_USER=comic
MYSQL_PASSWORD=comic_local_pwd
MYSQL_ROOT_PASSWORD=root_local_pwd
MYSQL_PORT=3308

# ==== Adminer ====
ADMINER_PORT=8082

# ==== Backend ====
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
STORAGE_ROOT=./uploads

# ==== Chatbot (Spring AI) ====
# Khóa API chỉ đặt qua biến môi trường, không bao giờ ghi vào application.yml hay Git.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
